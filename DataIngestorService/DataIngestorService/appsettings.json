{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "DataIngestorService"
    }
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "VirtualHostName": "/",
    "UserName": "guest",
    "Password": "guest",
    "PublishRetryCount": 3,
    "PublishRetryDelayMilliseconds": 1000
  },
  "WeakAppSettings": {
    "BaseUrl": "http://weak-app:8080",
    "AuthorizationKeyValue": "supersecret"
  }
}
