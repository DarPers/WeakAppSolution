      "id": 100,
      "title": "Sensor metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "Sensor event throughput",
      "targets": [
        {
          "expr": "sum(rate(sensor_events_fetched_total[1m]))",
          "legendFormat": "fetched",
          "refId": "A"
        },
        {
          "expr": "sum(rate(sensor_events_published_total[1m]))",
          "legendFormat": "published",
          "refId": "B"
        },
        {
          "expr": "sum(rate(sensor_events_persisted_total[1m]))",
          "legendFormat": "persisted",
          "refId": "C"
        },
        {
          "expr": "sum(rate(sensor_events_broadcast_total[1m]))",
          "legendFormat": "broadcast",
          "refId": "D"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
